+//////////////////////////////////////////////////////////////////////////////
+// Mimas fixture extraction hook (temporary, not upstream Yabause): dumps the
+// real 0x80-byte SMPC register window (odd-byte-per-register layout, exactly
+// matching Mimas's WorkRam::smpc_regs address mapping) to a fixed path once
+// per call, so a real, independently-derived SMPC state can be loaded into
+// Mimas's own test suite instead of a self-consistent guess.
+static void MimasDumpSmpcRegs(const char *tag) {
+   static int dumped = 0;
+   if (dumped) return;
+   const char *dir = getenv("MIMAS_FIXTURE_DIR");
+   if (!dir) return;
+   dumped = 1;
+   u8 buf[0x80];
+   int i;
+   memset(buf, 0, sizeof(buf));
+   for (i = 0; i < 7; i++) buf[0x01 + i * 2] = SmpcRegs->IREG[i];
+   buf[0x1F] = SmpcRegs->COMREG;
+   for (i = 0; i < 32; i++) buf[0x21 + i * 2] = SmpcRegs->OREG[i];
+   buf[0x61] = SmpcRegs->SR;
+   buf[0x63] = SmpcRegs->SF;
+   buf[0x75] = SmpcRegs->PDR[0];
+   buf[0x77] = SmpcRegs->PDR[1];
+   buf[0x79] = SmpcRegs->DDR[0];
+   buf[0x7B] = SmpcRegs->DDR[1];
+   buf[0x7D] = SmpcRegs->IOSEL;
+   buf[0x7F] = SmpcRegs->EXLE;
+   char path[512];
+   snprintf(path, sizeof(path), "%s/smpc_%s.bin", dir, tag);
+   FILE *f = fopen(path, "wb");
+   if (f) {
+      fwrite(buf, 1, sizeof(buf), f);
+      fclose(f);
+   }
+}
+
