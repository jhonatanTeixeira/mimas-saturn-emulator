/target
/out

# A BIOS e os traces *são* o programa: o trace traz opcode e desmontagem de
# cada instrução executada, e a imagem da BIOS já teve de ser removida do
# histórico uma vez. As capturas de tela não entram nesta regra — são pixels de
# saída, não contêm código, e estão versionadas em stubs/captures/.
/saturn_bios.bin
/bios_trace_*.txt
/branch_trace_*.txt
# Mesma regra para traces de um jogo comercial (qualquer prefixo, não só
# bios_/branch_): desmontagem de código com copyright de terceiros, nunca
# versionado. Cobre trace de SH-2, de desvios e de registradores do SCSP.
/*_trace.txt
/*_branch_trace.txt
/*_scsp_regs.txt
/*_frame_*.png
/*.chd
# Gameplay de um jogo comercial, fora do escopo do projeto. As capturas da
# BIOS em si (stubs/captures/) ficam versionadas: são o oráculo do projeto,
# são pixels de saída e não contêm programa nenhum.
/stubs/captures-game/
/dumped_frame_*.png
# Despejos da RAM de som: contêm o driver de som que a BIOS carrega, e o trace
# decodificado é a BIOS desmontada. Mesma regra da imagem e dos traces.
/som*.bin
/*soundram*.bin
/decoded*.txt
# Áudio despejado para comparação
/*.wav

# Sobras da fase de geração do interpretador, mantidas em disco e fora do build
/legacy_src/
/dump_data.rs
/dump_loop.rs
/test_offset.rs
/test_dynasm.rs
/decode.s
/gen_sh2.py
/generate_sh2.py
/scratch.py
/instruction_sh2.md
/run_log.txt

# Binários e objetos soltos gerados por aquelas sobras
/dump_data
/dump_loop
/test_offset
/decode.o

# Ferramentas de medição
/.venv
/lcov.info
/tarpaulin-report.html
