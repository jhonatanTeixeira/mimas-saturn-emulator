diff --git a/yabause/src/sh2int.c b/yabause/src/sh2int.c
index 3a8ff45..c7019a2 100644
--- a/yabause/src/sh2int.c
+++ b/yabause/src/sh2int.c
@@ -43,6 +43,81 @@ Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301  USA
 */
 
 #include "sh2core.h"
+
+/* ===== captura de trace (mimasv2/tools/trace-capture) =====================
+   Emite duas coisas, ambas filtradas por novidade:
+     <prefixo>_trace.txt         — primeira execução de cada PC, por núcleo
+     <prefixo>_branch_trace.txt  — primeira ocorrência de cada aresta de desvio
+   Nada aqui altera a emulação. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <signal.h>
+
+extern char current_mem_access[128];
+extern u32 YabauseGetFrameCount();
+extern int MimasTraceWindow(void);
+
+#define MIMAS_BRANCH_SLOTS 131072
+static u32 mimas_branch_from[MIMAS_BRANCH_SLOTS];
+static u32 mimas_branch_to[MIMAS_BRANCH_SLOTS];
+static int mimas_branch_cheia = 0;
+static u8 *mimas_visited_pcs = NULL;
+static FILE *mimas_trace_f = NULL;
+static FILE *mimas_branch_f = NULL;
+/* Última instrução vista, para o trace dizer onde a execução parou quando o
+   emulador morre no meio. */
+static volatile u32 mimas_ultimo_pc = 0;
+static volatile u32 mimas_ultimo_frame = 0;
+static volatile char mimas_ultimo_core = '?';
+
+static void MimasTraceEncerra(const char *motivo) {
+    /* Melhor esforço: stdio não é seguro em manipulador de sinal, mas um build
+       de captura que perde o fim do arquivo não serve para diagnosticar nada,
+       e o processo está morrendo de qualquer forma. */
+    if (mimas_trace_f) {
+        fprintf(mimas_trace_f, "# fim: %s | ultimo Frame: %u | Core: %c | PC: %08X\n",
+                motivo, (u32)mimas_ultimo_frame, (char)mimas_ultimo_core, (u32)mimas_ultimo_pc);
+        fflush(mimas_trace_f);
+    }
+    if (mimas_branch_f) fflush(mimas_branch_f);
+}
+
+static void MimasTraceAoSair(void) { MimasTraceEncerra("saida normal"); }
+
+static void MimasTraceSinal(int sig) {
+    char motivo[64];
+    snprintf(motivo, sizeof(motivo), "sinal %d", sig);
+    MimasTraceEncerra(motivo);
+    signal(sig, SIG_DFL);   /* deixa o crash aparecer como sempre apareceu */
+    raise(sig);
+}
+
+static FILE *MimasTraceOpen(const char *sufixo) {
+    static int ganchos = 0;
+    char caminho[256];
+    const char *prefixo = getenv("MIMAS_TRACE_PREFIX");
+    FILE *f;
+    snprintf(caminho, sizeof(caminho), "%s%s",
+             (prefixo && *prefixo) ? prefixo : "bios", sufixo);
+    f = fopen(caminho, "w");
+    if (!f) { fprintf(stderr, "[trace] nao consegui abrir %s\n", caminho); return NULL; }
+    if (!ganchos) {
+        int sinais[] = { SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT, SIGINT, SIGTERM };
+        unsigned i;
+        ganchos = 1;
+        atexit(MimasTraceAoSair);
+        for (i = 0; i < sizeof(sinais) / sizeof(sinais[0]); i++)
+            signal(sinais[i], MimasTraceSinal);
+    }
+    return f;
+}
+
+/* Sessão longa costuma ser encerrada à força; sem isto o fim fica no buffer. */
+static void MimasTraceFlush(FILE *f) {
+    static u32 linhas = 0;
+    if (++linhas % 1000 == 0) fflush(f);
+}
+/* ===== fim da instrumentação ============================================= */
 #include "sh2int.h"
 #include "sh2idle.h"
 #include "cs0.h"
@@ -3200,8 +3275,78 @@ FASTCALL void SH2InterpreterExec(SH2_struct *context, u32 cycles)
          break;
       }
 
-      // Execute it
-      opcodes[context->instruction](context);
+      /* ---- captura de trace ---- */
+      {
+         u32 exec_pc = context->regs.PC;
+         u16 exec_op = context->instruction;
+         u32 quadro = YabauseGetFrameCount();
+         int na_janela = MimasTraceWindow();
+         int pc_novo = 0;
+         int core_bit = (context == MSH2) ? 1 : 2;
+         static char disasm_buf[1024];
+
+         mimas_ultimo_pc = exec_pc;
+         mimas_ultimo_frame = quadro;
+         mimas_ultimo_core = (context == MSH2) ? 'M' : 'S';
+
+         if (na_janela) {
+            if (!mimas_visited_pcs) mimas_visited_pcs = (u8 *)calloc(0x8000000, 1);
+            if (mimas_visited_pcs) {
+               u32 pc_idx = (exec_pc >> 1) & 0x7FFFFFF;
+               if (!(mimas_visited_pcs[pc_idx] & core_bit)) {
+                  mimas_visited_pcs[pc_idx] |= core_bit;
+                  pc_novo = 1;
+                  current_mem_access[0] = '\0';
+                  SH2Disasm(exec_pc, exec_op, 0, &context->regs, disasm_buf);
+               }
+            }
+         }
+
+         // Execute it
+         opcodes[context->instruction](context);
+
+         if (pc_novo) {
+            if (!mimas_trace_f) mimas_trace_f = MimasTraceOpen("_trace.txt");
+            if (mimas_trace_f) {
+               if (current_mem_access[0] != '\0')
+                  fprintf(mimas_trace_f, "Frame: %u | Core: %c | PC: %08X | Opcode: %04X | %-25s | Mem: %s\n",
+                          quadro, (context == MSH2) ? 'M' : 'S',
+                          exec_pc, exec_op, disasm_buf, current_mem_access);
+               else
+                  fprintf(mimas_trace_f, "Frame: %u | Core: %c | PC: %08X | Opcode: %04X | %-25s\n",
+                          quadro, (context == MSH2) ? 'M' : 'S',
+                          exec_pc, exec_op, disasm_buf);
+               MimasTraceFlush(mimas_trace_f);
+            }
+         }
+
+         if (na_janela && !mimas_branch_cheia && context->regs.PC != exec_pc + 2) {
+            u32 destino = context->regs.PC;
+            u32 hash = ((exec_pc >> 1) ^ (destino >> 1)) & (MIMAS_BRANCH_SLOTS - 1);
+            int sondas = 0;
+            while (mimas_branch_from[hash] != 0 && sondas < MIMAS_BRANCH_SLOTS) {
+               if (mimas_branch_from[hash] == exec_pc && mimas_branch_to[hash] == destino) break;
+               hash = (hash + 1) & (MIMAS_BRANCH_SLOTS - 1);
+               sondas++;
+            }
+            /* Tabela cheia para de registrar. A versão anterior girava para
+               sempre aqui, o que basta um jogo para alcançar. */
+            if (sondas >= MIMAS_BRANCH_SLOTS) {
+               mimas_branch_cheia = 1;
+               fprintf(stderr, "[trace] tabela de desvios cheia (%d arestas); branch_trace para aqui\n",
+                       MIMAS_BRANCH_SLOTS);
+            } else if (mimas_branch_from[hash] == 0) {
+               mimas_branch_from[hash] = exec_pc;
+               mimas_branch_to[hash] = destino;
+               if (!mimas_branch_f) mimas_branch_f = MimasTraceOpen("_branch_trace.txt");
+               if (mimas_branch_f) {
+                  fprintf(mimas_branch_f, "Core: %c | Branch: %08X -> %08X | Opcode: %04X\n",
+                          (context == MSH2) ? 'M' : 'S', exec_pc, destino, exec_op);
+                  MimasTraceFlush(mimas_branch_f);
+               }
+            }
+         }
+      }
    }
 
    context->pre_cycle = context->cycles - target_cycle;
diff --git a/yabause/src/scsp.c b/yabause/src/scsp.c
--- a/yabause/src/scsp.c
+++ b/yabause/src/scsp.c
@@ -1491,6 +1491,165 @@
 
 
 
+/* ---- mimasv2 DSP capture -------------------------------------------------
+ *
+ * Dumps what the effect DSP is and what it does, so an emulator under
+ * development can be compared against this one step by step instead of by ear.
+ * Off unless MIMAS_DSP_CAPTURE=1, and then it writes, all from the SAME sample:
+ *
+ *   <prefix>_dsp_program.txt  microcode, coefficients and delay taps
+ *   <prefix>_dsp_state.txt    TEMP, MEMS and the rest of the DSP state
+ *   <prefix>_dsp_ram.bin      sound RAM, which holds the ring buffer
+ *   <prefix>_dsp_io.txt       one line per sample: 16 mixer inputs, 16 outputs
+ *   <prefix>_dsp_steps.txt    per-step state for the first samples
+ *
+ * Taking the program at one moment and the state at another does not compare:
+ * the sound driver reloads the DSP program during the boot, and a mismatched
+ * pair sends you hunting a maths bug that is not there.
+ */
+static int mimas_dsp_on(void)
+{
+  static int on = -1;
+  if (on < 0) {
+    const char *v = getenv("MIMAS_DSP_CAPTURE");
+    on = (v && *v != '0') ? 1 : 0;
+  }
+  return on;
+}
+
+static FILE *mimas_dsp_open(const char *suffix, const char *mode)
+{
+  const char *prefix = getenv("MIMAS_TRACE_PREFIX");
+  char name[256];
+  if (!prefix || !*prefix) prefix = "bios";
+  snprintf(name, sizeof(name), "%s_%s", prefix, suffix);
+  return fopen(name, mode);
+}
+
+static long mimas_dsp_rows(void)
+{
+  const char *v = getenv("MIMAS_DSP_ROWS");
+  long n = v ? strtol(v, NULL, 0) : 0;
+  return n > 0 ? n : 60000;
+}
+
+/* True while any slot is sending signal into the effect bus. */
+static int mimas_dsp_has_input(void)
+{
+  int k;
+  for (k = 0; k < 16; k++)
+    if (scsp_dsp.mixs[k]) return 1;
+  return 0;
+}
+
+static void mimas_dsp_snapshot(u8 *sound_ram)
+{
+  FILE *f;
+  int k;
+
+  f = mimas_dsp_open("dsp_program.txt", "w");
+  if (f) {
+    fprintf(f, "rbp %u rbl %u\n", (unsigned)scsp_dsp.rbp, (unsigned)scsp_dsp.rbl);
+    for (k = 0; k < 64; k++) fprintf(f, "coef %d %d\n", k, (int)scsp_dsp.coef[k]);
+    for (k = 0; k < 32; k++) fprintf(f, "madrs %d %u\n", k, (unsigned)scsp_dsp.madrs[k]);
+    for (k = 0; k < 128; k++)
+      fprintf(f, "mpro %d %016llX\n", k, (unsigned long long)scsp_dsp.mpro[k]);
+    fclose(f);
+  }
+
+  f = mimas_dsp_open("dsp_state.txt", "w");
+  if (f) {
+    fprintf(f, "mdec_ct %u\n", (unsigned)scsp_dsp.mdec_ct);
+    fprintf(f, "shift_reg %u\n", (unsigned)scsp_dsp.shift_reg);
+    fprintf(f, "frc_reg %u\n", (unsigned)scsp_dsp.frc_reg);
+    fprintf(f, "adrs_reg %u\n", (unsigned)scsp_dsp.adrs_reg);
+    fprintf(f, "y_reg %d\n", (int)scsp_dsp.y_reg);
+    fprintf(f, "io_addr %u\n", (unsigned)scsp_dsp.io_addr);
+    fprintf(f, "read_pending %d\n", scsp_dsp.read_pending);
+    fprintf(f, "write_pending %d\n", scsp_dsp.write_pending);
+    fprintf(f, "read_value %u\n", (unsigned)scsp_dsp.read_value);
+    fprintf(f, "write_value %u\n", (unsigned)scsp_dsp.write_value);
+    fprintf(f, "last_step %d\n", scsp_dsp.last_step);
+    for (k = 0; k < 128; k++) fprintf(f, "temp %d %d\n", k, (int)scsp_dsp.temp[k]);
+    for (k = 0; k < 32; k++) fprintf(f, "mems %d %d\n", k, (int)scsp_dsp.mems[k]);
+    fclose(f);
+  }
+
+  /* Sound RAM holds the ring buffer. Words are in host order, the same way
+     ScspDspExec reads them, so a reader on another machine may have to swap. */
+  f = mimas_dsp_open("dsp_ram.bin", "wb");
+  if (f) { fwrite(sound_ram, 1, 0x80000, f); fclose(f); }
+}
+
+/* Runs the program for one sample, capturing if asked. Returns nothing the
+   caller did not already know; it exists so the hot path keeps one shape. */
+static void mimas_dsp_run(u8 *sound_ram)
+{
+  static int snapped = 0;
+  static int traced = 0;
+  static FILE *stepf = NULL;
+  int i;
+
+  if (!mimas_dsp_on()) {
+    for (i = 0; i < scsp_dsp.last_step; i++)
+      ScspDspExec(&scsp_dsp, i, sound_ram);
+    return;
+  }
+
+  if (!snapped && mimas_dsp_has_input()) {
+    mimas_dsp_snapshot(sound_ram);
+    snapped = 1;
+  }
+
+  if (snapped && traced < 4) {
+    if (!stepf) stepf = mimas_dsp_open("dsp_steps.txt", "w");
+    for (i = 0; i < scsp_dsp.last_step; i++) {
+      ScspDspExec(&scsp_dsp, i, sound_ram);
+      if (stepf)
+        fprintf(stepf, "%d %d %u %u %u %d\n", traced, i,
+                (unsigned)scsp_dsp.shift_reg, (unsigned)scsp_dsp.io_addr,
+                (unsigned)scsp_dsp.read_value, (int)scsp_dsp.inputs);
+    }
+    if (stepf) fflush(stepf);
+    traced++;
+    return;
+  }
+
+  for (i = 0; i < scsp_dsp.last_step; i++)
+    ScspDspExec(&scsp_dsp, i, sound_ram);
+}
+
+/* One line per sample while there is signal: index, the 16 mixer inputs, the
+   16 effect outputs. Called after the program ran and before mixs is cleared. */
+static void mimas_dsp_log_io(void)
+{
+  static FILE *f = NULL;
+  static long rows = 0;
+  static long limit = 0;
+  static u64 last_sig = 0;
+  u64 sig = 0;
+  int k;
+
+  if (!mimas_dsp_on() || !mimas_dsp_has_input()) return;
+  if (!limit) limit = mimas_dsp_rows();
+  if (rows >= limit) return;
+  if (!f) f = mimas_dsp_open("dsp_io.txt", "w");
+  if (!f) return;
+
+  for (k = 0; k < 128; k++) sig += scsp_dsp.mpro[k];
+  if (last_sig && sig != last_sig)
+    fprintf(f, "# program replaced at row %ld\n", rows);
+  last_sig = sig;
+
+  fprintf(f, "%ld", rows);
+  for (k = 0; k < 16; k++) fprintf(f, " %d", (int)scsp_dsp.mixs[k]);
+  for (k = 0; k < 16; k++) fprintf(f, " %d", (int)scsp_dsp.efreg[k]);
+  fprintf(f, "\n");
+  if ((rows & 255) == 0) fflush(f);
+  rows++;
+}
