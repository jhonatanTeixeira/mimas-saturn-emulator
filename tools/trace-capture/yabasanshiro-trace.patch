+
+const char* GetSubsystemName(u32 addr) {
+    /* Mapa físico do Saturn; o bit cache-through 0x20000000 já sai no masked.
+       Esta tabela é paralela ao roteamento real do emulador — ela não decide
+       nada, só rotula. A primeira versão dela estava deslocada de uma região
+       (chamava o CD Block de SCSP, a RAM de som de CD Block e os registradores
+       do SCU de VDP2), e é por isso que os traces antigos trazem rótulo errado
+       com endereço certo. Faixa não listada não recebe rótulo nenhum. */
+    u32 masked = addr & 0x0FFFFFFF;
+    if (masked < 0x00100000)                         return "BIOS ROM";
+    if (masked >= 0x00100000 && masked < 0x00180000) return "SMPC";
+    if (masked >= 0x00180000 && masked < 0x00200000) return "Backup RAM";
+    if (masked >= 0x00200000 && masked < 0x00300000) return "Work RAM Low";
+    if (masked >= 0x01000000 && masked < 0x01800000) return "MINIT";
+    if (masked >= 0x01800000 && masked < 0x02000000) return "SINIT";
+    if (masked >= 0x02000000 && masked < 0x04000000) return "A-Bus CS0";
+    if (masked >= 0x04000000 && masked < 0x05000000) return "A-Bus CS1";
+    if (masked >= 0x05800000 && masked < 0x05900000) return "CD Block";
+    if (masked >= 0x05A00000 && masked < 0x05B00000) return "Sound RAM";
+    if (masked >= 0x05B00000 && masked < 0x05C00000) return "SCSP Regs";
+    if (masked >= 0x05C00000 && masked < 0x05C80000) return "VDP1 RAM";
+    if (masked >= 0x05C80000 && masked < 0x05D00000) return "VDP1 FB";
+    if (masked >= 0x05D00000 && masked < 0x05E00000) return "VDP1 Regs";
+    if (masked >= 0x05E00000 && masked < 0x05F00000) return "VDP2 RAM";
+    if (masked >= 0x05F00000 && masked < 0x05F80000) return "VDP2 CRAM";
+    if (masked >= 0x05F80000 && masked < 0x05FC0000) return "VDP2 Regs";
+    if (masked >= 0x05FE0000 && masked < 0x05FF0000) return "SCU Regs";
+    if (masked >= 0x06000000 && masked < 0x06100000) return "Work RAM High";
+    return "";
+}
